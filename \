#include <stdio.h>

int lim;

void check_syntax_errors(void);

int main (void){
    check_syntax_errors();
    return 0;
}

void check_syntax_errors(void){

    printf("Set the characters limit\n");
    if (scanf("%d", &lim) != 1 || lim <= 0){
        return;
    }
    getchar();
    
    int c, i, braces, brackets, paren, sq, dq, comment, esc, k, j;
    char arr_esc[11] = {'n', 't', 'r', '0', '\\', '\"', 'a', 'b', 'f', 'v'};
    char arr_rintf[5] = {'i', 'n', 't', 'f' };
    i = 0;
    braces = 0;
    brackets = 0;
    paren = 0;
    sq = 0;
    dq = 0;
    comment = 0;
    esc = 0;
    k = 0;
    j = 0;

    while(i < lim - 1 && (c = getchar()) != EOF ){
        
        if(c == 'p' ){
            for(k = 0; k < 5; k++){
                c = getchar()
                if(c == arr_rintf[k]){
                    j++;
                }else if(c == EOF ){
                    break;
                }
            }    
            if (j == k ){
                while(j > 0){
                    c = getchar()
                    if(c == ';' ){
                        j = 0;
                        break;
                    }else if (c == EOF ){
                        break;
                    }
                    j--;
                }
            }else{
                j = 0;
            }
        }

        if(c == '{' ){
            braces++;
        } else if(c == '}'){
            braces--;
        }
        
        if(c == '[' ){
            brackets++;
        } else if(c == ']'){
            brackets--;
        }
       
        if(c == '(' ){
                paren++;
        } else if(c == ')'){
            paren--;
        }

        if(c ==  '\'' ){
            sq++;
        }

        if(c == '\"' ){
            dq++;
        }

        if (c == '/' ){
            c = getchar();
            if (c == '/' ){
               comment = 0;
            } else if (c == '*' ){
                comment = 1;
                while(comment == 1 ){
                    c = getchar();
                    if (c == '*'){
                        c = getchar();
                        if(c == '/' ){
                            comment = 0;
                            break;
                        } else if (c == EOF || c != '/' ){
                           comment = 1;
                        }   
                    }
                }
            }
        }

        if( c == '\\' ){
            c = getchar();
            for(k = 0; k < 10; k++){
                if(c != arr_esc[k]){
                    esc = 1;
                }else{
                    break;
                }
            }

        }

        i++;

    }

    if (braces != 0 ){
        if(braces < 0 ){
            braces = braces * -1;
        }
        printf("%d unmatched braces\n", braces);
    } else {
        printf("correctly match braces\n");
    }
    
    if (brackets != 0 ){
        if(brackets < 0 ){
            brackets = brackets * -1;
        }
        printf("%d unmatched brackets\n", brackets);
    } else {
        printf("correctly match brackets\n");
    }

    if (paren != 0 ){
        if(paren < 0){
            paren = paren * -1;
        }
        printf("%d unmatched parenthesis\n", paren);
    } else {
        printf("correctly match parenthesis\n");
    }

    if(sq % 2 != 0 ){
        printf("%d unmatched simple quotes\n", sq);
    }else{
        printf("correctly match simple quotes\n");
    }

    if(dq % 2 != 0 ){
        printf("%d unmatched double quotes\n", dq);
    }else{
        printf("correctly match double quotes\n");
    }

    if(comment == 1 ){
        printf("a comment is not correctly closed\n");
    }else if (comment == 0 ){
        printf("no issues with comments\n");
    }

    if (esc == 1){
        printf("theres an invalid escape secuence used");
    }else if (esc == 0){
        printf("all escape secuences are correct");
    }
}

